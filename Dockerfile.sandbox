# syntax=docker/dockerfile:1.7
ARG BASE_REGISTRY=ghcr.io \
    BASE_OWNER=jdx \
    BASE_REPO=mise \
    BASE_TAG=2026.10.17-debian

ARG BASE_REF=${BASE_REGISTRY}/${BASE_OWNER}/${BASE_REPO}:${BASE_TAG}

FROM ${BASE_REF} AS sandbox-base

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

USER root

# Match OpenClaw's default sandbox UID/GID.
RUN groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid sandbox --create-home --shell /bin/bash sandbox \
    && install -d -o sandbox -g sandbox /workspace

ENV HOME=/home/sandbox \
    TERM=xterm-256color \
    MISE_CACHE_DIR=/tmp/.cache/mise \
    MISE_STATE_DIR=/tmp/.local/state/mise \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Global tool versions live outside HOME and the mounted workspace. Symlinks
# expose the locked binaries without mise shims or shell activation at runtime.
# Link npm's CLI directly to avoid mise's wrapper that refreshes shims.
COPY --chmod=0644 sandbox/mise.toml /mise/config.toml
COPY --chmod=0644 sandbox/mise.lock /mise/mise.lock
RUN --mount=type=cache,target=/tmp/.cache/mise,id=mise-cache,sharing=locked \
    mise install --locked \
    && for tool in node npx uv uvx; do \
        ln -s "$(mise which "$tool")" "/usr/local/bin/$tool"; \
    done \
    && ln -s "$(mise where node)/lib/node_modules/npm/bin/npm-cli.js" /usr/local/bin/npm \
    && node --version \
    && npm --version \
    && uv --version

USER sandbox
WORKDIR /workspace

ENTRYPOINT []
CMD ["sleep", "infinity"]

FROM sandbox-base AS sandbox

ARG EXTRA_APT_PKGS="" \
    EXTRA_NPM_LOCAL_PKGS="" \
    EXTRA_NPM_GLOBAL_PKGS="" \
    EXTRA_PIP_PKGS=""

USER root

ENV HOME=/root \
    NPM_CONFIG_PREFIX=/usr/local \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers

WORKDIR /app

# apt install
RUN --mount=type=cache,target=/var/cache/apt,id=sandbox-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=sandbox-apt-lib,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        ffmpeg \
        git \
        imagemagick \
        jq \
        python3 \
        python3-venv \
        ripgrep \
        rsync \
        yq \
        ${EXTRA_APT_PKGS} \
    && rm -rf /var/lib/apt/lists/*

# npm install
RUN --mount=type=cache,target=/root/.npm,id=npm-cache \
    npm i -g mcporter@0.16.0 @playwright/mcp@0.0.83 ${EXTRA_NPM_GLOBAL_PKGS} \
    && if [[ -n "${EXTRA_NPM_LOCAL_PKGS}" ]]; then \
        npm i ${EXTRA_NPM_LOCAL_PKGS}; \
    fi

# install the Chromium revision required by the installed Playwright MCP
RUN --mount=type=cache,target=/var/cache/apt,id=sandbox-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=sandbox-apt-lib,sharing=locked \
    --mount=type=cache,target=/pw-cache,id=pw-browsers,sharing=locked \
    playwright_dir="$(node -p 'require("path").dirname(require.resolve("playwright/package.json", { paths: [process.argv[1]] }))' "$(npm root -g)/@playwright/mcp")" \
    && PLAYWRIGHT_BROWSERS_PATH=/pw-cache \
        node "$playwright_dir/cli.js" install --with-deps --no-shell chromium \
    && mkdir -p "$PLAYWRIGHT_BROWSERS_PATH" \
    && rsync -a --delete /pw-cache/ "$PLAYWRIGHT_BROWSERS_PATH/" \
    && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH" \
    && ln -sf "$(node -e 'console.log(require(process.argv[1]).chromium.executablePath())' "$playwright_dir")" \
        /usr/local/bin/chromium \
    && test -x /usr/local/bin/chromium \
    && rm -rf /var/lib/apt/lists/*

# install optional Python tools independently of MCP servers
ENV PATH=/opt/python/bin:${PATH}
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache,sharing=locked \
    uv venv --python /usr/bin/python3 /opt/python \
    && printf '%s\n' 'export PATH="/opt/python/bin:$PATH"' > /etc/profile.d/python-tools.sh \
    && if [[ -n "${EXTRA_PIP_PKGS}" ]]; then \
        uv pip install --python /opt/python/bin/python ${EXTRA_PIP_PKGS}; \
    fi

# Readable defaults survive HOME mounts and work from every directory.
RUN install -d -m 0755 /etc/mcporter
COPY --chmod=0644 config/mcporter.sandbox.json /etc/mcporter/mcporter.json
ENV MCPORTER_CONFIG=/etc/mcporter/mcporter.json \
    MCPORTER_OAUTH_NO_BROWSER=1

# switch to runtime user
USER sandbox

ENV HOME=/home/sandbox \
    XDG_CACHE_HOME=/tmp/.cache

WORKDIR /workspace
