# syntax=docker/dockerfile:1.7
ARG BASE_REGISTRY=ghcr.io \
    BASE_OWNER=openclaw \
    BASE_REPO=openclaw \
    BASE_TAG=latest

ARG BASE_REF=${BASE_REGISTRY}/${BASE_OWNER}/${BASE_REPO}:${BASE_TAG}

FROM ${BASE_REF} AS gateway

ARG EXTRA_APT_PKGS="" \
    EXTRA_NPM_LOCAL_PKGS="" \
    EXTRA_NPM_GLOBAL_PKGS="" \
    EXTRA_PIP_PKGS=""

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

USER root

ENV TERM=xterm-256color

# apt install
RUN --mount=type=cache,target=/var/lib/apt,id=gateway-apt-lib,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,id=gateway-apt-cache,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        docker.io \
        jq \
        python3 \
        vim \
        yq \
        ${EXTRA_APT_PKGS} \
    && rm -rf /var/lib/apt/lists/*

# npm install
RUN --mount=type=cache,target=/root/.npm,id=npm-cache \
    npm i -g mcporter@0.16.0 ${EXTRA_NPM_GLOBAL_PKGS} \
    && if [[ -n "${EXTRA_NPM_LOCAL_PKGS}" ]]; then \
        npm i ${EXTRA_NPM_LOCAL_PKGS}; \
    fi

# install uv globally so the runtime user can execute it
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /usr/local/bin/

# install optional Python tools independently of MCP servers
ENV PATH=/opt/python/bin:${PATH}
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache,sharing=locked \
    uv venv --python /usr/bin/python3 /opt/python \
    && printf '%s\n' 'export PATH="/opt/python/bin:$PATH"' > /etc/profile.d/python-tools.sh \
    && if [[ -n "${EXTRA_PIP_PKGS}" ]]; then \
        uv pip install --python /opt/python/bin/python ${EXTRA_PIP_PKGS}; \
    fi

# Readable defaults survive HOME mounts and work from every directory.
RUN install -d -m 0755 /etc/mcporter
COPY --chmod=0644 config/mcporter.gateway.json /etc/mcporter/mcporter.json
ENV MCPORTER_CONFIG=/etc/mcporter/mcporter.json \
    MCPORTER_OAUTH_NO_BROWSER=1

# switch to runtime user
USER node

ENV HOME=/home/node

RUN openclaw completion --write-state \
    && openclaw completion -i -s bash
