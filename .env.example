# Absolute path on the outer Docker host, DinD, and the inner gateway.
OPENCLAW_USER_BASE=/mnt/cache/appdata/openclaw

# Shared DinD socket group ID; defaults to 2375. This is not a TCP port.
DOCKER_GID=

# Generate once with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

OPENCLAW_GATEWAY_IMAGE=ghcr.io/treyturner/openclaw:latest
OPENCLAW_SANDBOX_IMAGE=ghcr.io/treyturner/openclaw-sandbox:latest

# Outer host port mapping; not used when a proxy targets DinD's macvlan IP.
OPENCLAW_PUBLISH_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
# Browser origin, independent of the gateway's listening address.
OPENCLAW_CONTROL_UI_ORIGIN=http://127.0.0.1:18789

# Set the credentials needed by your selected model and integrations.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
TICKTICK_API_TOKEN=
