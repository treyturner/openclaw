# Absolute path on the Docker host. The gateway mounts it at the same path.
OPENCLAW_USER_BASE=/mnt/cache/appdata/openclaw

# Match the group ID reported by: stat -Lc %g /var/run/docker.sock
# For another socket, set DOCKER_SOCKET and inspect that path instead.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GID=

# Generate once with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

OPENCLAW_GATEWAY_IMAGE=ghcr.io/treyturner/openclaw:latest
OPENCLAW_SANDBOX_IMAGE=ghcr.io/treyturner/openclaw-sandbox:latest

# Host access is local by default. Change the origin with the published URL.
OPENCLAW_PUBLISH_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_CONTROL_UI_ORIGIN=http://127.0.0.1:18789

# Set the credentials needed by your selected model and integrations.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
TICKTICK_API_TOKEN=
